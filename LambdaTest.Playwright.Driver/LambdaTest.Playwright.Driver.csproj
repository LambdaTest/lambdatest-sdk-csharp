<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>$(Brand).Playwright.Driver</PackageId>
    <Version>1.0.0</Version>
    <Authors>Lambdatest-SmartUI</Authors>
    <Company>LambdaTest</Company>
    <Description>LambdaTest C# Playwright SDK with SmartUI support</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SdkUtilsVersion>1.0.3</SdkUtilsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Brand)' == 'TestmuAI'">
    <Authors>TestMu AI</Authors>
    <Company>TestMu AI</Company>
    <Description>TestMu AI (formerly LambdaTest) C# Playwright SDK with SmartUI support. Same SDK as LambdaTest.Playwright.Driver.</Description>
    <!-- TestmuAI.Sdk.Utils starts at 1.0.6; there is no 1.0.3 under the TestmuAI name. -->
    <SdkUtilsVersion>1.0.6</SdkUtilsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(Brand).Sdk.Utils" Version="$(SdkUtilsVersion)" />
    <PackageReference Include="Microsoft.Playwright" Version="1.47.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>
</Project>
